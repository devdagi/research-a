APP_NAME="Company Device Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Company Device Manager (CDM) — application policy & realtime (no secrets)
# Read in config/cdm.php when implemented; safe defaults for local/testing.
# ---------------------------------------------------------------------------

# Minutes without heartbeat before a device is marked offline in admin UI.
CDM_DEVICE_ONLINE_THRESHOLD_MINUTES=15

# Days to retain location history rows (purge job runs via scheduler).
CDM_LOCATION_RETENTION_DAYS=90

# Enrollment code validity window (one-time codes, hashed at rest).
CDM_ENROLLMENT_CODE_TTL_MINUTES=60

# Max lifetime for an active live WebRTC session record (signaling plane).
CDM_LIVE_SESSION_TTL_MINUTES=120

# Optional comma-separated TURN URLs for WebRTC NAT traversal (admin + API ICE config).
# Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
CDM_TURN_URLS=

# Optional TURN REST credentials (prefer short-lived creds from your TURN server).
CDM_TURN_USERNAME=
CDM_TURN_CREDENTIAL=

# Sanctum: add admin hostnames that use cookie/session auth (comma-separated).
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,testing.example.com

# Set true only after TURN/signaling is provisioned.
CDM_WEBRTC_CONFIGURED=false
CDM_COMMAND_TTL_MINUTES=30
CDM_ENROLLMENT_MAX_ATTEMPTS=10


MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

