[Unit]
Description=Company Device Manager — Laravel queue worker (testing)
After=network.target mariadb.service mysql.service
Wants=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/html/testing
Environment=APP_ENV=production

ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --max-time=3600 --timeout=120
ExecReload=/bin/kill -HUP $MAINPID

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cdm-queue

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
